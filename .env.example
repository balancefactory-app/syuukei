# =========================================================================
# Therapy English Coach — 環境変数サンプル
# このファイルを .env.local にコピーして値を設定してください。
# いずれも未設定でもアプリは動作します（ゲストモード / ルールベース採点に
# 自動フォールバック）。本番運用時に設定してください。
# =========================================================================

# --- Supabase（認証・学習データの永続化）------------------------------------
# 未設定の場合はブラウザの localStorage に保存する「ゲストモード」になります。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic Claude API（AIによる英文採点・添削）--------------------------
# 未設定の場合はキーワードベースの簡易採点にフォールバックします。
ANTHROPIC_API_KEY=

# 採点に使うモデル（省略時は claude-opus-4-8）。
# コスト重視なら claude-haiku-4-5 / claude-sonnet-5 なども指定可能。
ANTHROPIC_MODEL=claude-opus-4-8
