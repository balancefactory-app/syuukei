# =========================================================================
# Therapy English Coach — 環境変数サンプル
# このファイルを .env.local にコピーして値を設定してください。
# いずれも未設定でもアプリは動作します（ゲストモード / ルールベース採点に
# 自動フォールバック）。本番運用時に設定してください。
# =========================================================================

# --- Firebase（認証・学習データの永続化）------------------------------------
# 未設定の場合はブラウザの localStorage に保存する「ゲストモード」になります。
# 設定すると「ログイン必須（スタッフ限定公開）」になり、アカウントを持つ
# スタッフだけがアプリを利用できます。
# 値は Firebase コンソール → プロジェクトの設定 → マイアプリ（ウェブアプリ）
# の firebaseConfig から取得します。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# スタッフによる自己新規登録を許可するか（既定 false = 管理者がアカウント発行）。
# true にするとログイン画面に「新規登録」ボタンが表示されます。
NEXT_PUBLIC_ALLOW_SIGNUP=false

# --- Anthropic Claude API（AIによる英文採点・添削）--------------------------
# 未設定の場合はキーワードベースの簡易採点にフォールバックします。
ANTHROPIC_API_KEY=

# 採点に使うモデル（省略時は claude-opus-4-8）。
# コスト重視なら claude-haiku-4-5 / claude-sonnet-5 なども指定可能。
ANTHROPIC_MODEL=claude-opus-4-8
